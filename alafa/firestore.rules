rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // كتالوج المتجر: قراءة للجميع، تعديل للمدير فقط
    match /settings/{id}   { allow read: if true; allow write: if isAdmin(); }
    match /categories/{id} { allow read: if true; allow write: if isAdmin(); }
    match /products/{id}   { allow read: if true; allow write: if isAdmin(); }

    // الطلبات
    match /orders/{id} {
      // العميل يقرأ طلبه بمعرّفه العشوائي فقط (لا يمكنه سرد كل الطلبات)
      allow get: if true;
      allow list, update, delete: if isAdmin();
      allow create: if isAdmin() || validNewOrder(request.resource.data);
    }

    function validNewOrder(o) {
      return o.status == 'new'
        && o.stockApplied == false
        && o.items is list && o.items.size() > 0 && o.items.size() <= 100
        && o.total is number && o.total >= 0
        && o.customer is map
        && o.customer.name is string && o.customer.name.size() > 0 && o.customer.name.size() < 200
        && o.customer.phone is string && o.customer.phone.size() > 0 && o.customer.phone.size() < 40;
    }

    // قائمة المدراء: تُدار من Firebase Console فقط
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
